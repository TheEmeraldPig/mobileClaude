<Project Sdk="Microsoft.NET.Sdk">
  <!-- A BepInEx 5 plugin for Magicite. Run ./fetch-libs.sh first, then `dotnet build -c Release`. -->
  <PropertyGroup>
    <TargetFramework>net35</TargetFramework>
    <AssemblyName>MagiciteMod</AssemblyName>
    <RootNamespace>MagiciteMod</RootNamespace>
    <Version>1.0.0</Version>
    <LangVersion>7.3</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="BepInEx" HintPath="libs/BepInEx.dll" Private="false" />
    <Reference Include="UnityEngine" HintPath="libs/UnityEngine.dll" Private="false" />
  </ItemGroup>
</Project>
